enance/maint_log_export_2026.csv", "page": null, "chunk_id": null, "quote": "2026-06-20,HP1,\"oil leaking under the ram, pressure dropping\",Repl main cylinder seal kit,HLP46 x1; seal kit 50 x1,Lim Jia Hui,335,WO-6369"}, {"doc_path": "handovers/HO 06-20 A shift.txt", "page": null, "chunk_id": "DOC-32c1bca5-0-0", "quote": "- Press 2 stopped 1150 w/ Err:217, oli leaking under the ram, pressure dropping. Repl main cylinder seal kit (SEALKIT50), tested ok. Down approx 6h. f/u tmr."}], "path": [{"src": "INC-2026-031", "rel": "OCCURRED_ON", "dst": "HP-01"}, {"src": "INC-2026-031", "rel": "TRIGGERED_BY", "dst": "E-217"}, {"src": "INC-2026-031", "rel": "ROOT_CAUSE", "dst": "FM-MAIN-CYLINDER-SEAL-WEAR"}, {"src": "INC-2026-031", "rel": "USED", "dst": "OIL-HLP46-20L"}, {"src": "INC-2026-031", "rel": "USED", "dst": "SEAL-KIT-50"}]}], "history": null, "stock": [], "safety": {"required": true, "reason": "PROC-HP-04, PROC-HP-06 requires lockout and tagout; the question involves isolating a machine or a hazard to people.", "procedure_ids": ["PROC-HP-04", "PROC-HP-06"], "text": "Before you work on the hydraulic system, stop the pump, switch off the main isolator and fit your personal lock and tag. The system keeps stored hydraulic energy in the accumulator after the pump stops, so bleed the accumulator until its gauge reads 0 bar before you open any line. Lower the ram onto blocks and verify zero energy before you start. Apply lockout and tagout before starting. Verify zero energy.", "citations": [{"doc_path": "manuals/BH-250 service manual.pdf", "page": 2, "chunk_id": "DOC-5926a330-2-1", "quote": "Before you work on the hydraulic system, stop the pump, switch off the main isolator and fit your personal lock and tag. The system keeps stored hydraulic energy in the accumulator after the pump stops, so bleed the accumulator until its gauge reads 0 bar before you open any line. Lower the ram onto blocks and verify zero energy before you start."}, {"doc_path": "manuals/BH-250 service manual.pdf", "page": 5, "chunk_id": "DOC-5926a330-5-4", "quote": "WARNING: Apply lockout and tagout before starting. Verify zero energy."}, {"doc_path": "manuals/BH-250 service manual.pdf", "page": 6, "chunk_id": "DOC-5926a330-6-6", "quote": "WARNING: Apply lockout and tagout before starting. Verify zero energy."}]}, "claims": [{"id": "claim-1", "text": "E-217 indicates main cylinder pressure loss, with worn main cylinder seals listed as the most likely cause.", "citation_ids": ["C1"], "verdict": "supported", "p": 1.0, "support": 1.0, "reason": null}, {"id": "claim-2", "text": "The manual links oil leaking under the ram together with dropping pressure to worn main cylinder seals.", "citation_ids": ["C3"], "verdict": "supported", "p": 0.93, "support": 0.99, "reason": null}, {"id": "claim-3", "text": "Previous HP-01 breakdowns included oil on the floor with pressure loss, matching the reported symptoms.", "citation_ids": ["C4", "C11"], "verdict": "supported", "p": 0.93, "support": 0.99, "reason": null}, {"id": "claim-4", "text": "Relief valve misadjustment is an alternative cause; its listed symptoms are failure to reach tonnage and relief valve hissing.", "citation_ids": ["C1", "C3"], "verdict": "supported", "p": 0.97, "support": 1.0, "reason": null}], "unverified": [], "citations": {"C1": {"doc_path": "manuals/BH-250 service manual.pdf", "page": 3, "chunk_id": "DOC-5926a330-3-2", "quote": "2 Alarm table\nThe control shows these codes. Likely causes are listed in order of likelihood.\nCode\nMessage\nSeverity\nLikely causes\nAction\nE-200\nPump start\ninfo\nnone\nNo action required.\nE-217\nMain cylinder pressure loss\ncritical\nworn main cylinder seals (most likely)\nrelief valve out of adjustment (possible)\nSee 4.1 Replace main cylinder seal kit\n(plant ref PROC-HP-04)\nSee 4.3 Reset and test relief valve\n(plant ref PROC-HP-06)\nE-221\nHydraulic oil temperature high\nwarning\ncontaminated hydraulic oil (most likely)\nrelief valve out of adjustment (possible)\nSee 4.2 Change hydraulic oil and filter\n(plant ref PROC-HP-05)\nSee 4.3 Reset and test relief valve\n(plant ref PROC-HP-06)\nE-230\nPump pressure unstable\nwarning\ncontaminated hydraulic oil (most likely)\nSee 4.2 Change hydraulic oil and filter\n(plant ref PROC-HP-05)\nE-245\nOil level low\nwarning\nworn main cylinder seals (most likely)\nSee 4.1 Replace main cylinder seal kit\n(plant ref PROC-HP-04)\nE-252\nRelief valve pressure out of range\ncritical\nrelief valve out of adjustment (most likely)\nSee 4.3 Reset and test relief valve\n(plant ref PROC-HP-06)"}, "C3": {"doc_path": "manuals/BH-250 service manual.pdf", "page": 4, "chunk_id": "DOC-5926a330-4-3", "quote": "3 Troubleshooting table\nFind the symptom, then follow the remedy.\nSymptom\nProbable cause\nRemedy\noil leaking under the ram, pressure dropping\nworn main cylinder seals\nSee 4.1 Replace main cylinder seal kit\n(plant ref PROC-HP-04)\noil looks dark and milky, pump noisy\ncontaminated hydraulic oil\nSee 4.2 Change hydraulic oil and filter\n(plant ref PROC-HP-05)\npress cannot reach tonnage, relief valve hissing\nrelief valve out of adjustment\nSee 4.3 Reset and test relief valve\n(plant ref PROC-HP-06)"}, "C4": {"doc_path": "maintenance/maint_log_export_2026.csv", "page": null, "chunk_id": null, "quote": "28/09/2026,hyd press,\"ERR 217: press losing pressure mid-stroke, oil on the floor\",Repl main cylinder seal kit,HLP46 x1; SEALKIT50 x1,Rajesh Pillai,approx 420,WO-9989"}, "C11": {"doc_path": "maintenance/maint_log_export_2026.csv", "page": null, "chunk_id": null, "quote": "22/04/2026,hyd press,\"press losing pressure mid-stroke, oil on the floor\",Repl main cylinder seal kit,HLP46 x1; SEAL KIT 50 x1,RP,525,WO-3456"}}, "path": [{"src": "E-217", "rel": "INDICATES", "dst": "FM-MAIN-CYLINDER-SEAL-WEAR"}, {"src": "FM-MAIN-CYLINDER-SEAL-WEAR", "rel": "AFFECTS", "dst": "HP-01-MAINCYL"}, {"src": "HP-01", "rel": "HAS_COMPONENT", "dst": "HP-01-MAINCYL"}, {"src": "E-217", "rel": "INDICATES", "dst": "FM-RELIEF-VAL